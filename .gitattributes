# Set default behavior to automatically normalize line endings.
*           text=auto

#
# The above will handle all files NOT found below
#

# Solutions
*.sln       text eol=crlf
*.slnx      text

# Projects
*.*proj     text
*.tasks     text
*.props     text
*.targets   text

# Sources
*.cs        text diff=csharp
*.cshtml    text diff=html
*.css       text diff=css
*.csx       text diff=csharp
*.htm       text diff=html
*.html      text diff=html
*.resx      text
*.ts        text
*.tsx       text

# Scripts
*.bash      text eol=lf
*.fish      text eol=lf
*.ksh       text eol=lf
*.sh        text eol=lf
*.zsh       text eol=lf

# Windows Scripts
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.ps1       text eol=crlf

# Serialisation
*.json      text
*.xml       text
*.yaml      text
*.yml       text

# Documents
*.doc       diff=astextplain
*.DOC       diff=astextplain
*.docx      diff=astextplain
*.DOCX      diff=astextplain
*.dot       diff=astextplain
*.DOT       diff=astextplain
*.pdf       diff=astextplain
*.PDF       diff=astextplain
*.rtf       diff=astextplain
*.RTF       diff=astextplain
*.md        text diff=markdown
*.mdx       text diff=markdown
*.adoc      text
*.textile   text
*.mustache  text
*.csv       text eol=crlf
*.tab       text
*.tsv       text
*.txt       text
*.sql       text

# Graphics
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.tif       binary
*.tiff      binary
*.ico       binary
*.eps       binary
*.svg       text

# Archives
*.7z        binary
*.bz        binary
*.bz2       binary
*.bzip2     binary
*.gz        binary
*.lz        binary
*.lzma      binary
*.rar       binary
*.tar       binary
*.taz       binary
*.tbz       binary
*.tbz2      binary
*.tgz       binary
*.tlz       binary
*.txz       binary
*.xz        binary
*.Z         binary
*.zip       binary
*.zst       binary

# Fonts
*.ttf       binary
*.eot       binary
*.otf       binary
*.woff      binary
*.woff2     binary

# Keys
*.snk       binary
*.pfx       binary
*.cer       binary
